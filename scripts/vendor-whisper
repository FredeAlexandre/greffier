#!/bin/sh
# Copies into engines/whisper.cpp/ the whisper.cpp sources Greffier needs (whisper, ggml, CPU,
# Metal, Accelerate's BLAS), from the archive of the pinned version. engines/build.rs compiles
# them without cmake.
#
#     scripts/vendor-whisper
#
# To change version: update VERSION and SHA256 here and in engines/build.rs, then run again.
set -eu
VERSION=1.9.5
SHA256=ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720
ROOT=$(cd "$(dirname "$0")/.." && pwd)
TARGET="$ROOT/engines/whisper.cpp"
STAGING=$(mktemp -d)
trap 'rm -rf "$STAGING"' EXIT

curl -fsSL -o "$STAGING/w.tgz" "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v$VERSION.tar.gz"
echo "$SHA256  $STAGING/w.tgz" | shasum -a 256 -c - >/dev/null || { echo "unexpected sha256" >&2; exit 1; }
tar xzf "$STAGING/w.tgz" -C "$STAGING"
S="$STAGING/whisper.cpp-$VERSION"

rm -rf "$TARGET"
mkdir -p "$TARGET"
cd "$S"
{
    echo LICENSE
    echo include/whisper.h
    find src -maxdepth 1 -name 'whisper*'
    find src/aneforge -type f
    find ggml/include -name '*.h'
    find ggml/src -maxdepth 1 -type f \( -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.in' \)
    find ggml/src/ggml-cpu -type f \( -name '*.c' -o -name '*.cpp' -o -name '*.h' \) \
        -not -path '*/kleidiai/*' -not -path '*/spacemit/*' -not -path '*/cmake/*' \
        \( -not -path '*/arch/*' -o -path '*/arch/arm/*' \)
    find ggml/src/ggml-metal -type f \( -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.m' -o -name '*.metal' -o -name CMakeLists.txt \)
    echo ggml/src/ggml-blas/ggml-blas.cpp
} | sort | while read -r f; do
    mkdir -p "$TARGET/$(dirname "$f")"
    cp "$f" "$TARGET/$f"
done
echo "whisper.cpp $VERSION → $TARGET ($(du -sh "$TARGET" | cut -f1))"
